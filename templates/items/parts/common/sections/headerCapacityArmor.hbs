<h3 class="header">
    <i data-action="jsToggle" class="far fa-minus-square"></i>
    <input type="text" name="{{path}}" value="{{label}}"
            {{#if this.softlock}}disabled{{/if}}/>

    <div>
        <a class="verrouillage" data-action="softlock">
            {{localize "KNIGHT.AUTRE.Verrouiller"}}
            <i class="fa-solid {{ifThen value 'fa-check green' 'fa-xmark red'}}"></i>
        </a>
        <a class="delete" data-type="{{this.master}}" data-action="capacityDelete">
            {{localize "KNIGHT.AUTRE.Supprimer"}}
        </a>
    </div>
</h3>