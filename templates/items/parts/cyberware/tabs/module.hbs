<div class="{{tab.cssClass}}" data-group="primary" data-tab="module">
    <button type="action"
        data-action="btnToggle"
        data-path="module.withMetaArmure"
        class="toggle {{ifThen systemData.module.withMetaArmure 'selected' 'unselected'}} double">
        <span>{{localize "KNIGHT.CYBERWARE.AvecMetaArmure"}}</span>
        <i class="fa-solid {{ifThen systemData.module.withMetaArmure 'fa-check green' 'fa-xmark red'}}"></i>
    </button>

    <button
        type="action"
        data-action="btnToggle"
        data-path="module.ersatz.rogue.has"
        class="toggle {{ifThen systemData.module.ersatz.rogue.has 'selected' 'unselected'}}">
        <span>{{localize "KNIGHT.ITEMS.MODULE.ERSATZ.ROGUE.Label"}}</span>
        <i class="fa-solid {{ifThen systemData.module.ersatz.rogue.has 'fa-check green' 'fa-xmark red'}}"></i>
    </button>

    <button
        type="action"
        data-action="btnToggle"
        data-path="module.ersatz.bard.has"
        class="toggle {{ifThen systemData.module.ersatz.bard.has 'selected' 'unselected'}}">
        <span>{{localize "KNIGHT.ITEMS.MODULE.ERSATZ.BARD.Label"}}</span>
        <i class="fa-solid {{ifThen systemData.module.ersatz.bard.has 'fa-check green' 'fa-xmark red'}}"></i>
    </button>

    {{#if systemData.module.ersatz.rogue.has}}
    <div class="ersatz double">
        <h3 class="title double">{{localize "KNIGHT.ITEMS.MODULE.ERSATZ.ROGUE.Label"}}</h3>

        <label class="input noLeft">
            <span>{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.GHOST.BonusPasserInaperçu"}}</span>
            <input type="number"  data-dtype="Number"name="system.module.ersatz.rogue.reussites" value="{{systemData.module.ersatz.rogue.reussites}}" min="0" />
        </label>

        <label class="select noRight">
            <span>{{localize "KNIGHT.BONUS.Attaque"}}</span>
            <select name="system.module.ersatz.rogue.attaque">
                {{selectOptions (onlyCarac) selected=systemData.module.ersatz.rogue.attaque localize=true}}
            </select>
        </label>

        <button
            type="action"
            data-action="btnToggle"
            data-path="module.ersatz.rogue.interruption.actif"
            class="toggle {{ifThen systemData.module.ersatz.rogue.interruption.actif 'selected' 'unselected'}}">
            <span>{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.GHOST.Interruption"}}</span>
            <i class="fa-solid {{ifThen systemData.module.ersatz.rogue.interruption.actif 'fa-check green' 'fa-xmark red'}}"></i>
        </button>

        <div class="rightCol">
            <h3 class="subtitle">{{localize "KNIGHT.BONUS.Degats"}}</h3>

            <label class="select noRight">
                <span>{{localize "KNIGHT.ITEMS.Caracteristique"}}</span>
                <select name="system.module.ersatz.rogue.degats.caracteristique">
                    {{selectOptions (onlyCarac) selected=systemData.module.ersatz.rogue.degats.caracteristique localize=true}}
                </select>
            </label>

            <button
                type="action"
                data-action="btnToggle"
                data-path="module.ersatz.rogue.degats.od"
                class="toggle {{ifThen systemData.module.ersatz.rogue.degats.od 'selected' 'unselected'}}">
                <span>{{localize "KNIGHT.INCLUS.Od"}}</span>
                <i class="fa-solid {{ifThen systemData.module.ersatz.rogue.degats.od 'fa-check green' 'fa-xmark red'}}"></i>
            </button>

            <button
                type="action"
                data-action="btnToggle"
                data-path="module.ersatz.rogue.degats.dice"
                class="toggle {{ifThen systemData.module.ersatz.rogue.degats.dice 'selected' 'unselected'}}">
                <span>{{localize "KNIGHT.INCLUS.Dice"}}</span>
                <i class="fa-solid {{ifThen systemData.module.ersatz.rogue.degats.dice 'fa-check green' 'fa-xmark red'}}"></i>
            </button>

            <button
                type="action"
                data-action="btnToggle"
                data-path="module.ersatz.rogue.degats.fixe"
                class="toggle {{ifThen systemData.module.ersatz.rogue.degats.fixe 'selected' 'unselected'}}">
                <span>{{localize "KNIGHT.INCLUS.Fixe"}}</span>
                <i class="fa-solid {{ifThen systemData.module.ersatz.rogue.degats.fixe 'fa-check green' 'fa-xmark red'}}"></i>
            </button>
        </div>
    </div>
    {{/if}}
</div>