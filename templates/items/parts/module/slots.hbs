
<div class="slots">
    <h2 class="header">
        <i data-action="jsToggle" class="far fa-minus-square"></i>
        {{localize "KNIGHT.ITEMS.ARMURE.SLOTS.Label"}}
    </h2>

    <label>
        <span class="title">{{localize "KNIGHT.ITEMS.ARMURE.SLOTS.Tete"}}</span>
        <input type="number"  data-dtype="Number"name="system.slots.tete" value="{{systemData.slots.tete}}" min="0" />
    </label>

    <label>
        <span class="title">{{localize "KNIGHT.ITEMS.ARMURE.SLOTS.BrasGauche"}}</span>
        <input type="number"  data-dtype="Number"name="system.slots.brasGauche" value="{{systemData.slots.brasGauche}}" min="0" />
    </label>

    <label>
        <span class="title">{{localize "KNIGHT.ITEMS.ARMURE.SLOTS.BrasDroit"}}</span>
        <input type="number"  data-dtype="Number"name="system.slots.brasDroit" value="{{systemData.slots.brasDroit}}" min="0" />
    </label>

    <label>
        <span class="title">{{localize "KNIGHT.ITEMS.ARMURE.SLOTS.Torse"}}</span>
        <input type="number"  data-dtype="Number"name="system.slots.torse" value="{{systemData.slots.torse}}" min="0" />
    </label>

    <label>
        <span class="title">{{localize "KNIGHT.ITEMS.ARMURE.SLOTS.JambeGauche"}}</span>
        <input type="number"  data-dtype="Number"name="system.slots.jambeGauche" value="{{systemData.slots.jambeGauche}}" min="0" />
    </label>

    <label>
        <span class="title">{{localize "KNIGHT.ITEMS.ARMURE.SLOTS.JambeDroite"}}</span>
        <input type="number"  data-dtype="Number"name="system.slots.jambeDroite" value="{{systemData.slots.jambeDroite}}" min="0" />
    </label>
</div>