<div class="bodyTab effects" data-tab="effects" style="{{ifThen effects.has '' 'display:none'}}">
    <span class="header">
        {{localize "KNIGHT.LISTEFFECTS.Label"}}
    </span>
    <div class="mod">
        <div class="list">
            {{#each effects.list as |data index |}}
                <select class="path" name="system.niveau.details.{{../key}}.effects.list.{{index}}.path">
                    {{selectOptions (getCFG 'EFFECTS.SIMPLE') selected=data.path localize=true sort=true}}
                </select>
                <select class="type" name="system.niveau.details.{{../key}}.effects.list.{{index}}.type">
                    {{selectOptions (getCFG 'EFFECTS.TYPE') selected=data.type localize=true}}
                </select>
                <input class="value" type="{{getEFFECTSINPUT data.path}}" name="system.niveau.details.{{../key}}.effects.list.{{index}}.value" value="{{data.value}}" />
                <a class="delete" data-action="deleteSpecialEffects" data-tooltip="{{localize "KNIGHT.AUTRE.DeleteItem"}}" data-index="{{index}}"><i class="fas fa-trash"></i></a>
            {{/each}}
        </div>
    </div>
    <button type="action"
        data-action="addSpecialEffects"
        class="add">
        <i class="fa-solid fa-plus"></i>
        <span>{{localize "KNIGHT.AUTRE.Ajouter"}}</span>
        <i class="fa-solid fa-plus"></i>
    </button>
</div>