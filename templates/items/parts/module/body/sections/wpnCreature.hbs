
<div class="liste">
    <label class="inputWithLabel col long top left">
        <span class="label">{{localize "KNIGHT.Nom"}}</span>
        <input type="text" name="{{path}}.nom" value="{{nom}}" />
    </label>

    <label class="selectWithLabel col top right">
        <span class="label">{{localize "KNIGHT.ITEMS.MODULE.ARME.TYPE.Label"}}</span>
        <select name="{{path}}.type">
            {{selectOptions (getList 'typearmesmodules') selected=type localize=true}}
        </select>
    </label>

    <label class="selectWithLabel {{ifThen (eq type 'tourelle') 'long' 'col'}}">
        <span class="label">{{localize "KNIGHT.PORTEE.Label"}}</span>
        <select name="{{path}}.portee">
            {{selectOptions (getList 'portee') selected=portee localize=true}}
        </select>
    </label>

    <div class="diceWithLabel col" style="{{ifThen (eq type 'tourelle') '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.AUTRE.Attaque"}}</span>
        <div>
            <input type="number"
            name="{{path}}.attaque.dice"
            value="{{attaque.dice}}"
            min="0" />

            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>

            <input type="number"
            name="{{path}}.attaque.fixe"
            value="{{attaque.fixe}}"
            min="0" />
        </div>
    </div>

    <div class="diceWithLabel col mid">
        <span class="label">{{localize "KNIGHT.AUTRE.Degats"}}</span>
        <div>
            <input type="number"
            name="{{path}}.degats.dice"
            value="{{degats.dice}}"
            min="0" />

            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>

            <input type="number"
            name="{{path}}.degats.fixe"
            value="{{degats.fixe}}"
            min="0" />
        </div>
    </div>

    <div class="diceWithLabel col">
        <span class="label">{{localize "KNIGHT.AUTRE.Violence"}}</span>
        <div>
            <input type="number"
            name="{{path}}.violence.dice"
            value="{{violence.dice}}"
            min="0" />

            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>

            <input type="number"
            name="{{path}}.violence.fixe"
            value="{{violence.fixe}}"
            min="0" />
        </div>
    </div>

    <div class="blockEffets">
        <h2 class="header">
            {{localize "KNIGHT.EFFETS.Label"}}
        </h2>

        <div class="effets">
            {{#each effets.liste as | key effet|}}
                {{~> knight.effets type='base'}}
            {{/each}}
            <a class="edit" data-action="editEffects"
            data-path="{{simplePath}}.effets">
                <span>{{localize "KNIGHT.EFFETS.Edit"}}</span>
            </a>
        </div>
    </div>

    <a class="delete" data-action="delete" data-type="armes" data-npc="{{npc}}" data-id="{{id}}" data-tooltip="{{localize "KNIGHT.AUTRE.DeleteItem"}}">
        <i class="fas fa-minus"></i>
    </a>
</div>