<div class="bodyTab blockEffets" data-tab="effets" style="{{ifThen effets.has '' 'display:none'}}">
    <h2 class="header">
        {{localize "KNIGHT.EFFETS.Label"}}
    </h2>

    <div class="effets">
        {{#each effets.liste as | key effet|}}
            {{~> knight.effets type='base'}}
        {{/each}}
        <a class="edit" data-action="editEffects" data-path="niveau.details.{{key}}.effets">
            <span>{{localize "KNIGHT.EFFETS.Edit"}}</span>
        </a>
    </div>
</div>