
    <header class="sheet-header">
        <h1 class="name">
            <input name="name" type="text" value="{{item.name}}" placeholder="{{localize "KNIGHT.Nom"}}" />

            <select name="system.niveau.value" {{#if systemData.noEditLvl}}disabled{{/if}}>
                {{selectOptions (getNiveau systemData.niveau.details) selected=systemData.niveau.value}}
            </select>
        </h1>

        <div class="description">
            <h2 class="header">
                {{localize "KNIGHT.Description"}}
            </h2>

            {{formInput
                systemFields.description
                enriched=enrichedDescription
                value=systemData.description
                documentUUID=item.uuid
                name="system.description"
                collaborate="false"
                toggled="true"
            }}
        </div>
    </header>