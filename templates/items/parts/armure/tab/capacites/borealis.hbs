
<div class="dataCapacity borealis">
    {{~> knight.armure.capacites.common.header
        path="capacites.selected.borealis"
        label=label
    }}

    {{~> knight.armure.capacites.common.description
        field=@root.systemFields.capacites.fields.selected.fields.borealis.fields.description
        path="capacites.selected.borealis"
        value=description
        enriched=@root.enrichedCapacites.borealis
    }}

    <fieldset class="mainData" {{ifThen softlock 'disabled' ''}}>
        <div class="data">
            <h4>{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.BOREALIS.SUPPORT.Label"}}</h4>
            <textarea data-capacite="borealis" data-type="descriptionSupport" data-min="120"
            style="height:{{textarea.descriptionSupport}}px;"
            name="{{path.string}}.support.description">{{support.description}}</textarea>
            <h4>{{localize "KNIGHT.LATERAL.Energie"}}</h4>
            <label class="inputWithLabel">
                <span class="label">{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.BOREALIS.SUPPORT.Base"}}</span>
                <input type="number" name="{{path.string}}.support.energie.base" value="{{support.energie.base}}"/>
            </label>
            <label class="inputWithLabel">
                <span class="label">{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.BOREALIS.SUPPORT.Allie"}}</span>
                <input type="number" name="{{path.string}}.support.energie.allie" value="{{support.energie.allie}}" />
            </label>
            <label class="selectWithLabel double">
                <span class="label">{{localize "KNIGHT.ACTIVATION.Label"}}</span>
                <select name="{{path.string}}.support.activation">
                    {{selectOptions (getList 'activationcapacites') selected=this.support.activation localize=true}}
                </select>
            </label>
            <div class="textareaWithLabel">
                <span class="label">{{localize "KNIGHT.DUREE.Label"}}</span>
                <textarea data-capacite="borealis" data-type="dureeSupport" data-min="50" style="height:{{textarea.dureeSupport}}px;" name="{{path.string}}.support.duree">{{this.support.duree}}</textarea>
            </div>
        </div>

        <div class="data">
            <h4>{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.BOREALIS.OFFENSIF.Label"}}</h4>
            <textarea data-capacite="borealis" data-type="descriptionOffensif" data-min="85"
            style="height:{{textarea.descriptionOffensif}}px;"
            name="{{path.string}}.offensif.description">{{offensif.description}}</textarea>
            <label class="inputWithLabel">
                <span class="label">{{localize "KNIGHT.LATERAL.Energie"}}</span>
                <input type="number" name="{{path.string}}.offensif.energie" value="{{offensif.energie}}"/>
            </label>
            <div class="diceSpanWithLabel">
                <span class="label">{{localize "KNIGHT.AUTRE.Degats"}}</span>
                <div>
                    <input type="number" name="{{path.string}}.offensif.degats.dice" value="{{offensif.degats.dice}}"/>
                    <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6</span>
                </div>
            </div>
            <div class="diceSpanWithLabel">
                <span class="label">{{localize "KNIGHT.AUTRE.Violence"}}</span>
                <div>
                    <input type="number" name="{{path.string}}.offensif.violence.dice" value="{{offensif.violence.dice}}"/>
                    <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6</span>
                </div>
            </div>
            <label class="selectWithLabel double">
                <span class="label">{{localize "KNIGHT.ACTIVATION.Label"}}</span>
                <select name="{{path.string}}.offensif.activation">
                    {{selectOptions (getList 'activationcapacites') selected=offensif.activation localize=true}}
                </select>
            </label>
            <label class="selectWithLabel">
                <span class="label">{{localize "KNIGHT.PORTEE.Label"}}</span>
                <select name="{{path.string}}.offensif.portee">
                    {{selectOptions (getList 'portee') selected=offensif.portee localize=true}}
                </select>
            </label>
            <div class="textareaWithLabel notBorderTop">
                <span class="label">{{localize "KNIGHT.DUREE.Label"}}</span>
                <textarea data-capacite="borealis" data-type="dureeOffensif" data-min="50"
                style="height:{{textarea.dureeOffensif}}px;"
                name="{{path.string}}.offensif.duree">{{offensif.duree}}</textarea>
            </div>
            {{~> knight.armure.capacites.common.effects liste=offensif.effets.liste type='borealis' path="capacites.selected.borealis.offensif.effets"}}
        </div>

        <div class="data">
            <h4>{{localize "KNIGHT.ITEMS.ARMURE.CAPACITES.BOREALIS.UTILITAIRE.Label"}}</h4>
            <textarea data-capacite="borealis" data-type="descriptionUtilitaire" data-min="150"
            style="height:{{textarea.descriptionUtilitaire}}px;"
            name="{{path.string}}.utilitaire.description">{{utilitaire.description}}</textarea>
            <label class="inputWithLabel">
                <span class="label">{{localize "KNIGHT.LATERAL.Energie"}}</span>
                <input type="number" name="{{path.string}}.utilitaire.energie" value="{{utilitaire.energie}}"/>
            </label>
            <label class="selectWithLabel double">
                <span class="label">{{localize "KNIGHT.ACTIVATION.Label"}}</span>
                <select name="{{path.string}}.utilitaire.activation">
                    {{selectOptions (getList 'activationcapacites') selected=utilitaire.activation localize=true}}
                </select>
            </label>
            <div class="textareaWithLabel">
                <span class="label">{{localize "KNIGHT.DUREE.Label"}}</span>
                <textarea data-capacite="borealis" data-type="dureeUtilitaire" data-min="50"
                style="height:{{textarea.dureeUtilitaire}}px;"
                name="{{path.string}}.utilitaire.duree">{{utilitaire.duree}}</textarea>
            </div>
        </div>
    </fieldset>
</div>
