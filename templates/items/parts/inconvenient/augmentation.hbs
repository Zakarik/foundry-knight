<div class="reduction">
    <div>
        <span class="label">
            {{localize "KNIGHT.ITEMS.DESAVANTAGE.Aspects"}}
        </span>
        <label>
            <span>{{localize "KNIGHT.ITEMS.DESAVANTAGE.Multiplier"}}</span>
            <input type="number" name="system.bonus.coutsReduits.aspect.divise" min="0" value="{{systemData.bonus.coutsAugmentes.aspect.divise}}" />
        </label>
        <label>
            <span>{{localize "KNIGHT.ITEMS.DESAVANTAGE.Augmenter"}}</span>
            <input type="number" name="system.bonus.coutsReduits.aspect.value" min="0" value="{{systemData.bonus.coutsAugmentes.aspect.value}}" />
        </label>
    </div>
    <div>
        <span class="label">
            {{localize "KNIGHT.ITEMS.DESAVANTAGE.Caracteristiques"}}
        </span>
        <label>
            <span>{{localize "KNIGHT.ITEMS.DESAVANTAGE.Multiplier"}}</span>
            <input type="number" name="system.bonus.coutsReduits.caracteristique.divise" min="0" value="{{systemData.bonus.coutsAugmentes.caracteristique.divise}}" />
        </label>
        <label>
            <span>{{localize "KNIGHT.ITEMS.DESAVANTAGE.Augmenter"}}</span>
            <input type="number" name="system.bonus.coutsReduits.caracteristique.value" min="0" value="{{systemData.bonus.coutsAugmentes.caracteristique.value}}" />
        </label>
    </div>
</div>