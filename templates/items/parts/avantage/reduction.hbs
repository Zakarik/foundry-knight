<div class="reduction">
    <div>
        <span class="label">
            {{localize "KNIGHT.ITEMS.AVANTAGE.Aspects"}}
        </span>
        <label>
            <span>{{localize "KNIGHT.ITEMS.AVANTAGE.Diviser"}}</span>
            <input type="number" name="system.bonus.coutsReduits.aspect.divise" min="0" value="{{systemData.bonus.coutsReduits.aspect.divise}}" />
        </label>
        <label>
            <span>{{localize "KNIGHT.ITEMS.AVANTAGE.Diminuer"}}</span>
            <input type="number" name="system.bonus.coutsReduits.aspect.value" min="0" value="{{systemData.bonus.coutsReduits.aspect.value}}" />
        </label>
    </div>
    <div>
        <span class="label">
            {{localize "KNIGHT.ITEMS.AVANTAGE.Caracteristiques"}}
        </span>
        <label>
            <span>{{localize "KNIGHT.ITEMS.AVANTAGE.Diviser"}}</span>
            <input type="number" name="system.bonus.coutsReduits.caracteristique.divise" min="0" value="{{systemData.bonus.coutsReduits.caracteristique.divise}}" />
        </label>
        <label>
            <span>{{localize "KNIGHT.ITEMS.AVANTAGE.Diminuer"}}</span>
            <input type="number" name="system.bonus.coutsReduits.caracteristique.value" min="0" value="{{systemData.bonus.coutsReduits.caracteristique.value}}" />
        </label>
    </div>
