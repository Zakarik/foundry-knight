            <input type="number"  data-dtype="Number"name="system.passives.capacites.cea.update.salve.degats.fixe" value="{{systemData.passives.capacites.cea.update.salve.degats.fixe}}" min="0"/>
        </div>
    </div>

    <div class="diceWithLabel" style="{{ifThen systemData.passives.capacites.cea.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.AUTRE.Violence"}}</span>
        <div>
            <input type="number"  data-dtype="Number"name="system.passives.capacites.cea.update.salve.violence.dice" value="{{systemData.passives.capacites.cea.update.salve.violence.dice}}" min="0"/>
