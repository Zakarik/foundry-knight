            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"  data-dtype="Number"name="system.passives.capacites.cea.update.rayon.violence.fixe" value="{{systemData.passives.capacites.cea.update.rayon.violence.fixe}}" min="0"/>
        </div>
    </div>

    <div class="blockEffets" style="{{ifThen systemData.passives.capacites.cea.actif '' 'display:none;'}}">
        {{~> knight.wpn.effects.onlyEffects
        effectsList=systemData.passives.capacites.cea.update.rayon.effets.liste
        effectType='base'
        limitedEffects='true'
