<div class="data {{ifThen systemData.passives.capacites.morph.actif 'checked' ''}}">
    {{~> knight.item.btnToggle
        value=systemData.passives.capacites.morph.actif
        path="system.passives.capacites.morph.actif"
        localize="KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Label"
    }}

    <h3 class="subtitre" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Vol"}}</h3>

    <div class="textarea border" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.Description"}}</span>
        <textarea name="system.passives.capacites.morph.update.vol.description"
            data-toupdate="passives.capacites.morph.update.vol.textarea"
            data-min="20"
            style="height:{{systemData.passives.capacites.morph.update.vol.textarea}}px;"
            >{{systemData.passives.capacites.morph.update.vol.description}}</textarea>
    </div>

    <h3 class="subtitre borderDouble" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Etirement"}}</h3>

    <div class="textarea border" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.PORTEE.Label"}}</span>
        <textarea name="system.passives.capacites.morph.update.etirement.portee"
            data-toupdate="passives.capacites.morph.update.etirement.textarea"
            data-min="20"
            style="height:{{systemData.passives.capacites.morph.update.etirement.textarea}}px;"
            >{{systemData.passives.capacites.morph.update.etirement.portee}}</textarea>
    </div>

    <h3 class="subtitre borderDouble" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Metal"}}</h3>

    <label style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.BONUS.ChampDeForce"}}</span>
        <input type="number"
            name="system.passives.capacites.morph.update.metal.bonus.champDeForce"
            value="{{systemData.passives.capacites.morph.update.metal.bonus.champDeForce}}" min="0"/>
    </label>

    <h3 class="subtitre borderDouble" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Fluide"}}</h3>

    <label style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.BONUS.Reaction"}}</span>
        <input type="number"
            name="system.passives.capacites.morph.update.fluide.bonus.reaction"
            value="{{systemData.passives.capacites.morph.update.fluide.bonus.reaction}}" min="0"/>
    </label>

    <label style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.BONUS.Defense"}}</span>
        <input type="number"
            name="system.passives.capacites.morph.update.fluide.bonus.defense"
            value="{{systemData.passives.capacites.morph.update.fluide.bonus.defense}}" min="0"/>
    </label>

    <h3 class="subtitre borderDouble" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Polymorphie"}}</h3>

    <div class="textarea border" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.Description"}}</span>
        <textarea name="system.passives.capacites.morph.update.polymorphie.description"
            data-toupdate="passives.capacites.morph.update.polymorphie.textarea"
            data-min="20"
            style="height:{{systemData.passives.capacites.morph.update.polymorphie.textarea}}px;"
            >{{systemData.passives.capacites.morph.update.polymorphie.description}}</textarea>
    </div>

    <h4 class="subtitre" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Griffe"}}</h4>

    <div class="diceWBonus" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.AUTRE.Degats"}}</span>
        <div>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.griffe.degats.dice"
                value="{{systemData.passives.capacites.morph.update.polymorphie.griffe.degats.dice}}" min="0"/>
            <span>{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.griffe.degats.fixe"
                value="{{systemData.passives.capacites.morph.update.polymorphie.griffe.degats.fixe}}" min="0"/>
        </div>
    </div>

    <div class="diceWBonus" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.AUTRE.Violence"}}</span>
        <div>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.griffe.violence.dice"
                value="{{systemData.passives.capacites.morph.update.polymorphie.griffe.violence.dice}}" min="0"/>
            <span>{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.griffe.violence.fixe"
                value="{{systemData.passives.capacites.morph.update.polymorphie.griffe.violence.fixe}}" min="0"/>
        </div>
    </div>

    <div class="blockEffets" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        {{~> knight.wpn.effects.onlyEffects
        effectsList=systemData.passives.capacites.morph.update.polymorphie.griffe.effets.liste
        effectType='base'
        limitedEffects='true'
        wpnPath='passives.capacites.morph.update.polymorphie.griffe.'}}
    </div>

    <h4 class="subtitre" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Lame"}}</h4>

    <div class="diceWBonus" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span>{{localize "KNIGHT.AUTRE.Degats"}}</span>
        <div>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.lame.degats.dice"
                value="{{systemData.passives.capacites.morph.update.polymorphie.lame.degats.dice}}" min="0"/>
            <span>{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.lame.degats.fixe"
                value="{{systemData.passives.capacites.morph.update.polymorphie.lame.degats.fixe}}" min="0"/>
        </div>
    </div>

    <div class="diceWithLabel" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.AUTRE.Violence"}}</span>
        <div>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.lame.violence.dice"
                value="{{systemData.passives.capacites.morph.update.polymorphie.lame.violence.dice}}" min="0"/>
            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.lame.violence.fixe"
                value="{{systemData.passives.capacites.morph.update.polymorphie.lame.violence.fixe}}" min="0"/>
        </div>
    </div>

    <div class="blockEffets" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        {{~> knight.wpn.effects.onlyEffects
        effectsList=systemData.passives.capacites.morph.update.polymorphie.lame.effets.liste
        effectType='base'
        limitedEffects='true'
        wpnPath='passives.capacites.morph.update.polymorphie.lame.'}}
    </div>

    <h4 class="subtitre" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.MORPH.Canon"}}</h4>

    <div class="diceWithLabel" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.AUTRE.Degats"}}</span>
        <div>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.canon.degats.dice"
                value="{{systemData.passives.capacites.morph.update.polymorphie.canon.degats.dice}}" min="0"/>
            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.canon.degats.fixe"
                value="{{systemData.passives.capacites.morph.update.polymorphie.canon.degats.fixe}}" min="0"/>
        </div>
    </div>

    <div class="diceWithLabel" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.AUTRE.Violence"}}</span>
        <div>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.canon.violence.dice"
                value="{{systemData.passives.capacites.morph.update.polymorphie.canon.violence.dice}}" min="0"/>
            <span class="dice">{{localize "KNIGHT.JETS.Des-short"}}6+</span>
            <input type="number"
                name="system.passives.capacites.morph.update.polymorphie.canon.violence.fixe"
                value="{{systemData.passives.capacites.morph.update.polymorphie.canon.violence.fixe}}" min="0"/>
        </div>
    </div>

    <div class="blockEffets" style="{{ifThen systemData.passives.capacites.morph.actif '' 'display:none;'}}">
        {{~> knight.wpn.effects.onlyEffects
        effectsList=systemData.passives.capacites.morph.update.polymorphie.canon.effets.liste
        effectType='base'
        limitedEffects='true'
        wpnPath='passives.capacites.morph.update.polymorphie.canon.'}}
    </div>
</div>