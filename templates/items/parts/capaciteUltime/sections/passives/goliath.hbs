<div class="data {{ifThen systemData.passives.capacites.goliath.actif 'checked' ''}}">
    {{~> knight.item.btnToggle
        value=systemData.passives.capacites.goliath.actif
        path="system.passives.capacites.goliath.actif"
        localize="KNIGHT.CAPACITEULTIME.PASSIVE.GOLIATH.Label"
    }}

    <label class="inputWithLabel" style="{{ifThen systemData.passives.capacites.goliath.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.GOLIATH.Taille"}}</span>
        <input type="number" name="system.passives.capacites.goliath.update.taille.max" value="{{systemData.passives.capacites.goliath.update.taille.max}}" min="0"/>
    </label>

    <label class="inputWithLabel" style="{{ifThen systemData.passives.capacites.goliath.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.GOLIATH.Reaction"}}</span>
        <input type="number" name="system.passives.capacites.goliath.update.malus.reaction.value" value="{{systemData.passives.capacites.goliath.update.malus.reaction.value}}" min="0"/>
    </label>

    <label class="inputWithLabel" style="{{ifThen systemData.passives.capacites.goliath.actif '' 'display:none;'}}">
        <span class="label">{{localize "KNIGHT.CAPACITEULTIME.PASSIVE.GOLIATH.Defense"}}</span>
        <input type="number" name="system.passives.capacites.goliath.update.malus.defense.value" value="{{systemData.passives.capacites.goliath.update.malus.defense.value}}" min="0"/>
    </label>
</div>